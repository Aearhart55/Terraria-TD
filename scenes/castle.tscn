[sub_resource type="GDScript" id="GDScript_jxdab"]
resource_name = "castle_interact"
script/source = "extends InteractionArea

func _ready() -> void:
	super._ready()
	Signals.final_wave.connect(disable)

func interaction() -> void:
	Signals.advance_wave.emit()
	Signals.wave_finished.emit()
"

