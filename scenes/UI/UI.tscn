[sub_resource type="GDScript" id="GDScript_ok71f"]
resource_name = "pause_button"
script/source = "extends ToggleButton

@export var unpaused_items : Array[Control]

func _input(_event) -> void:
	if Input.is_action_just_pressed(\"pause\"):
		button_pressed = !button_pressed
		
func command() -> void:
	get_tree().paused = button_pressed
	
	for item in unpaused_items:
		item.visible = button_pressed
"

