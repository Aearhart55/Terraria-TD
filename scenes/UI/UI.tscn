[sub_resource type="GDScript" id="GDScript_alvv5"]
resource_name = "build_mode_button"
script/source = "extends Button

@export var pressed_texture : TextureRect
@export var released_texture : TextureRect

func _ready() -> void:
	toggled.connect(_on_toggle)
	
func _on_toggle(toggled_on : bool) -> void:
	Signals.toggled_build_mode.emit(toggled_on)
	pressed_texture.visible = toggled_on
	released_texture.visible = !toggled_on
	
func _unhandled_input(_event: InputEvent) -> void:
	if Input.is_action_just_pressed(\"build_mode_input\"):
		button_pressed = !button_pressed
"

