[sub_resource type="GDScript" id="GDScript_0odk7"]
resource_name = "money_label"
script/source = "extends Label

func _ready() -> void:
	Global.money_update.connect(func(value : int): text = \"$\" + str(value))
	text = \"$\" + str(Global.player_cash)
"

[sub_resource type="GDScript" id="GDScript_t1j05"]
resource_name = "enemy_count"
script/source = "extends Label

func _process(_delta: float) -> void:
	if not Settings.show_remaining_enemies:
		hide()
		return
	
	show()
	text = str(get_tree().get_node_count_in_group(\"enemy\"))
"

