[sub_resource type="GDScript" id="GDScript_e6oqk"]
resource_name = "interact_button"
script/source = "extends TouchButton

func _process(_delta: float) -> void:
	if Signals.player_interact.has_connections():
		show()
	else:
		hide()

func _unhandled_input(_event: InputEvent) -> void:
	if Input.is_action_just_pressed(\"interact\"):
		Signals.player_interact.emit()

func _on_button_down() -> void:
	var interact := InputEventAction.new()
	interact.action = \"interact\"
	interact.pressed = true
	Input.parse_input_event(interact)
	press_texture.visible = true
	release_texture.visible = false

func _on_button_up() -> void:
	var interact := InputEventAction.new()
	interact.action = \"interact\"
	interact.pressed = false
	Input.parse_input_event(interact)
	press_texture.visible = false
	release_texture.visible = true
"

