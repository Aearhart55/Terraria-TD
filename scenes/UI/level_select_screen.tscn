[sub_resource type="GDScript" id="GDScript_4bg0q"]
resource_name = "level_box"
script/source = "extends Control

const DEFAULT_BUTTON = preload(\"uid://b4nfi7bk1rnt2\")
const DEFAULT_BUTTON_PRESSED = preload(\"uid://wy71eme0cfoy\")
const MONOGRAM = preload(\"uid://cwi14pqrh43uo\")

func _ready() -> void:
	for level in SceneSwitcher.scene_list:
		match level:
			\"start\":
				pass
			\"lose\":
				pass
			\"retry\":
				pass
			\"level_select_screen\":
				pass
			_:
				var new_level = SceneSwitchButton.new()
				new_level.scene_name = level
				new_level.text = level
				new_level.add_theme_font_override(\"font\", MONOGRAM)
				new_level.add_theme_stylebox_override(\"normal\", DEFAULT_BUTTON)
				new_level.add_theme_stylebox_override(\"hover\", DEFAULT_BUTTON_PRESSED)
				new_level.add_theme_stylebox_override(\"pressed\", DEFAULT_BUTTON_PRESSED)
				add_child(new_level)
"

