[sub_resource type="GDScript" id="GDScript_dl30m"]
resource_name = "Preview Towers"
script/source = "extends CheckBox

func _enter_tree() -> void:
	button_pressed = Settings.towers_preview_placement

func _on_toggled(_toggled_on: bool) -> void:
	Settings.towers_preview_placement = button_pressed
"

[sub_resource type="GDScript" id="GDScript_livli"]
resource_name = "debug options"
script/source = "extends CheckButton

func _ready() -> void:
	if button_pressed:
		for option in get_tree().get_nodes_in_group(\"debug_setting\"):
			option.show()
	else:
		for option in get_tree().get_nodes_in_group(\"debug_setting\"):
			option.hide()

func _on_toggled(_toggled_on: bool) -> void:
	if button_pressed:
		for option in get_tree().get_nodes_in_group(\"debug_setting\"):
			option.show()
	else:
		for option in get_tree().get_nodes_in_group(\"debug_setting\"):
			option.hide()
"

